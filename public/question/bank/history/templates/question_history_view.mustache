{{!
    @template qbank_history/question_history_view

    The question history view template, showing the header, and question list.

    If there are no versions of the question to display, a notification and continue button is displayed instead.

    Example context (json):
    {
        "contextid": 1234,
        "header": {
            "returnurl": "https://url/courseid=1",
            "questionicon": {
                "attributes": [
                    {
                        "name": "src",
                        "value": "https://moodle.org/logo/moodle-logo.svg"
                    },
                    {
                        "name": "class",
                        "value": "iconsmall"
                    },
                    {
                        "name": "alt",
                        "value": "Alt text for icon"
                    }
                ]
            },
            "questionname": "Question 1"
        },
        "questionlist": {
            "component": "core_question",
            "callback": "get_question_list",
            "contextid": 1,
            "plugincontrols": "<select><option>Plugin control</option></select>",
            "baseurl": "https://example.com/question/bank.php?id=1",
            "sesskey": "123",
            "urlparams": [
                {
                    "name": "qperpage",
                    "value": 100
                }
            ],
            "filtercondition": "",
            "questiontable": {
                "hascategoryfilter": "true",
                "pagingbartop": {
                    "previous": null,
                    "next": {
                        "page": 2,
                        "url": "./page.php?p=1"
                    },
                    "first": null,
                    "last": {
                        "page": 100,
                        "url": "./page.php?p=99"
                    },
                    "label": "Page",
                    "pages": [
                        {
                            "page": 1,
                            "active": true,
                            "url": null
                        },
                        {
                            "page": 2,
                            "active": false,
                            "url": "./page.php?p=1"
                        }
                    ],
                    "haspages": true,
                    "pagesize": 10
                },
                "defaultsort": "",
                "columnheaders": [
                    {
                        "sortable": false,
                        "extraclasses": "checkbox pe-1",
                        "tiptitle": "Column 1",
                        "sorttip": true,
                        "tip": "Sort by column 1",
                        "class": "plugin_class",
                        "name": "plugin_name"
                    },
                    {
                        "sortable": true,
                        "extraclasses": "checkbox pe-1",
                        "tiptitle": "Column 2",
                        "sorttip": true,
                        "tip": "Sort by column 2",
                        "class": "plugin_class2",
                        "name": "plugin_name2"
                    }
                ],
                "rows": [
                    {
                        "attributes": [
                            {
                                "name": "class",
                                "value": "row0"
                            }
                        ],
                        "columns": [
                            {
                                "column": "<td>Question 1 Column 1</td>"
                            },
                            {
                                "column": "<td>Question 1 Column 2</td>"
                            }
                        ]
                    },
                    {
                        "attributes": [
                            {
                                "name": "class",
                                "value": "row1"
                            }
                        ],
                        "columns": [
                            {
                                "column": "<td>Question 2 Column 1</td>"
                            },
                            {
                                "column": "<td>Question 2 Column 2</td>"
                            }
                        ]
                    }
                ]
            },
            "bottomcontrols": "<select><option>Bulk action</option></select>"
        }
    }
}}
{{<core_question/view}}
    {{$content}}
        {{#noversions}}
            {{#notification}}{{>core/notification}}{{/notification}}
            {{#continue}}{{>core/single_button}}{{/continue}}
        {{/noversions}}
        {{^noversions}}
            {{#header}}{{>qbank_history/history_header}}{{/header}}
            {{#questionlist}}{{>core_question/question_list}}{{/questionlist}}
        {{/noversions}}
    {{/content}}
{{/core_question/view}}