{{!
    @template core_question/checkbox_cell

    Example context (json):
    {
        "class": "question-checkbox_cell-column",
        "data-columnid": "core_question-checkbox_cell",
        "checkbox": {
            "id": "select-item",
            "name": "select-item",
            "togglegroup": "toggle-group",
            "label": "Select me!",
            "checked": true,
            "classes": "p-1",
            "labelclasses": "badge bg-info text-white"
        }
    }
}}
{{<core_question/question_cell}}
    {{$content}}
        {{#checkbox}}
            {{>core/checkbox-toggleall-target}}
        {{/checkbox}}
    {{/content}}
{{/core_question/question_cell}}

