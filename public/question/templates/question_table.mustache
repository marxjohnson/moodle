{{!
    @template core_question/question_table

    Template for question lists in the question bank.

    Example context (json):
    {
        "hascategoryfilter": "true",
        "pagingbartop": {
            "previous": null,
            "next": {
                "page": 2,
                "url": "./page.php?p=1"
            },
            "first": null,
            "last": {
                "page": 100,
                "url": "./page.php?p=99"
            },
            "label": "Page",
            "pages": [
                {
                    "page": 1,
                    "active": true,
                    "url": null
                },
                {
                    "page": 2,
                    "active": false,
                    "url": "./page.php?p=1"
                }
            ],
            "haspages": true,
            "pagesize": 10
        },
        "defaultsort": "",
        "columnheaders": [
            {
                "sortable": false,
                "extraclasses": "checkbox pe-1",
                "tiptitle": "Column 1",
                "sorttip": true,
                "tip": "Sort by column 1",
                "class": "plugin_class",
                "name": "plugin_name"
            },
            {
                "sortable": true,
                "extraclasses": "checkbox pe-1",
                "tiptitle": "Column 2",
                "sorttip": true,
                "tip": "Sort by column 2",
                "class": "plugin_class2",
                "name": "plugin_name2"
            }
        ],
        "rows": [
            {
                "attributes": [
                    {
                        "name": "class",
                        "value": "row0"
                    }
                ],
                "columns": [
                    {
                        "column": "<td>Question 1 Column 1</td>"
                    },
                    {
                        "column": "<td>Question 1 Column 2</td>"
                    }
                ]
            },
            {
                "attributes": [
                    {
                        "name": "class",
                        "value": "row1"
                    }
                ],
                "columns": [
                    {
                        "column": "<td>Question 2 Column 1</td>"
                    },
                    {
                        "column": "<td>Question 2 Column 2</td>"
                    }
                ]
            }
        ]
    }
}}
{{^hascategoryfilter}}
    {{> qbank_managecategories/choose_category }}
{{/hascategoryfilter}}
{{#hascategoryfilter}}
    {{#pagingbartop}}
        {{> core/paging_bar }}
    {{/pagingbartop}}
    <div class="question_table" id="question_table">
        <table id="categoryquestions" class="question-bank-table table generaltable" data-defaultsort="{{defaultsort}}">
            <thead>
                <tr class="qbank-column-list">
                    {{#columnheaders}}
                        {{> core_question/column_header }}
                    {{/columnheaders}}
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    {{#extrarow}}
                        {{{row}}}
                    {{/extrarow}}
                    {{^extrarow}}
                        {{>core_question/question_row}}
                    {{/extrarow}}
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{#pagingbarbottom}}
        {{> core/paging_bar }}
    {{/pagingbarbottom}}
{{/hascategoryfilter}}