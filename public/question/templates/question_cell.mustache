{{!
    @template core_question/question_cell

    Template for a single cell in a question row.

    Example context (json):
    {
        "class": "question-bank-column",
        "columnid": "qbank_example-column1",
        "content": "Default content"
    }
}}
<{{#heading}}th scope="row"{{/heading}}{{^heading}}td{{/heading}}
    class="{{class}}"
    data-columnid="{{columnid}}"
    {{#colspan}}colspan="{{colspan}}"{{/colspan}}
>
    {{$content}}{{content}}{{/content}}
</{{#heading}}th{{/heading}}{{^heading}}td{{/heading}}>

