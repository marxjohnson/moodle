{{!
    @template core_question/question_row

    Template for question rows in the question bank.

    Example context (json):
    {
        "attributes": [
            {
                "name": "class",
                "value": "row1"
            }
        ],
        "columns": [
            {
                "column": "<td>Question 1 Column 1</td>"
            },
            {
                "column": "<td>Question 1 Column 2</td>"
            }
        ]
    }
}}
<tr{{#attributes}} {{name}}="{{value}}"{{/attributes}}>
    {{#columns}}{{{column}}}{{/columns}}
</tr>
