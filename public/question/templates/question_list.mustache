{{!
    @template core_question/question_list

    Template for question lists in the question bank.

    Example context (json):
    {
        "component": "core_question",
        "callback": "get_question_list",
        "contextid": 1,
        "plugincontrols": "<select><option>Plugin control</option></select>",
        "baseurl": "https://example.com/question/bank.php?id=1",
        "sesskey": "123",
        "urlparams": [
            {
                "name": "qperpage",
                "value": 100
            }
        ],
        "filtercondition": "",
        "questiontable": {
            "hascategoryfilter": "true",
            "pagingbartop": {
                "previous": null,
                "next": {
                    "page": 2,
                    "url": "./page.php?p=1"
                },
                "first": null,
                "last": {
                    "page": 100,
                    "url": "./page.php?p=99"
                },
                "label": "Page",
                "pages": [
                    {
                        "page": 1,
                        "active": true,
                        "url": null
                    },
                    {
                        "page": 2,
                        "active": false,
                        "url": "./page.php?p=1"
                    }
                ],
                "haspages": true,
                "pagesize": 10
            },
            "defaultsort": "",
            "columnheaders": [
                {
                    "sortable": false,
                    "extraclasses": "checkbox pe-1",
                    "tiptitle": "Column 1",
                    "sorttip": true,
                    "tip": "Sort by column 1",
                    "class": "plugin_class",
                    "name": "plugin_name"
                },
                {
                    "sortable": true,
                    "extraclasses": "checkbox pe-1",
                    "tiptitle": "Column 2",
                    "sorttip": true,
                    "tip": "Sort by column 2",
                    "class": "plugin_class2",
                    "name": "plugin_name2"
                }
            ],
            "rows": [
                {
                    "attributes": [
                        {
                            "name": "class",
                            "value": "row0"
                        }
                    ],
                    "columns": [
                        {
                            "column": "<td>Question 1 Column 1</td>"
                        },
                        {
                            "column": "<td>Question 1 Column 2</td>"
                        }
                    ]
                },
                {
                    "attributes": [
                        {
                            "name": "class",
                            "value": "row1"
                        }
                    ],
                    "columns": [
                        {
                            "column": "<td>Question 2 Column 1</td>"
                        },
                        {
                            "column": "<td>Question 2 Column 2</td>"
                        }
                    ]
                }
            ]
        },
        "bottomcontrols": "<select><option>Bulk action</option></select>"
    }
}}
<div id="questionscontainer" data-component="{{component}}" data-callback="{{callback}}" data-contextid="{{contextid}}">
    {{{plugincontrols}}}
    <form action="{{baseurl}}" method="post" id="questionsubmit">
        <fieldset class="invisiblefieldset" style="display: block;">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="addonpage">
            {{#urlparams}}
                <input type="hidden" name="{{name}}" value="{{value}}">
            {{/urlparams}}
            <div class="categoryquestionscontainer" data-filtercondition="{{filtercondition}}">
            {{#questiontable}}
                {{> core_question/question_table}}
            {{/questiontable}}
            </div>
            {{#bottomcontrols}}
                {{{bottomcontrols}}}
            {{/bottomcontrols}}
        </fieldset>
    </form>
</div>